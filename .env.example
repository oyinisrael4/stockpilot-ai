DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=stockpilot
PGUSER=stockpilot
PGPASSWORD=
STOCKPILOT_PUBLIC_URL=http://localhost:5173
# Optional text intent provider. Leave both blank for limited local demonstration mode.
STOCKPILOT_AI_PROVIDER=openai
STOCKPILOT_AI_API_KEY=
STOCKPILOT_AI_MODEL=
STOCKPILOT_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# Ollama mode uses a downloaded local model and needs no key.
STOCKPILOT_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
# Production requires explicit hosts, HTTPS origin, a strong secret and shared cache initialization.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STOCKPILOT_ALLOW_REGISTRATION=1
# For hosted PostgreSQL use verify-full plus your provider's trusted CA.
# PGSSLMODE=verify-full
# Public demo flag requires the dedicated stockpilot_demo database.
STOCKPILOT_PUBLIC_DEMO=0
# Production WSGI server stays on loopback behind TLS.
STOCKPILOT_PORT=8000
