# Copy to deploy/.env.render only for private local cloud verification.
# Never commit the filled file. Put these values in Render's private Environment UI.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DATABASE_URL=
# Direct Neon URL: database stockpilot_demo, NO -pooler hostname,
# query sslmode=verify-full&sslrootcert=system
GROQ_API_KEY=
STOCKPILOT_AI_PROVIDER=groq
STOCKPILOT_AI_MODEL=openai/gpt-oss-120b
STOCKPILOT_VOICE_PROVIDER=groq
STOCKPILOT_GROQ_VOICE_MODEL=whisper-large-v3-turbo
# Set to 1 only after confirming the Groq organization is still Free, with no billing upgrade.
STOCKPILOT_CLOUD_FREE_ONLY=1
STOCKPILOT_CLOUD_CHAT_DAILY_LIMIT=50
STOCKPILOT_CLOUD_CHAT_MINUTE_LIMIT=2
STOCKPILOT_CLOUD_AUDIO_DAILY_SECONDS=600
STOCKPILOT_CLOUD_AUDIO_HOURLY_SECONDS=120
STOCKPILOT_PUBLIC_DEMO=1
STOCKPILOT_SERVE_FRONTEND=1
STOCKPILOT_ALLOW_REGISTRATION=0
STOCKPILOT_PASSWORD_RESET_ENABLED=0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
# Generate two separate strong passwords. Owner password stays private.
STOCKPILOT_DEMO_PASSWORD=
STOCKPILOT_DEMO_VISITOR_PASSWORD=
# Render startup derives these from its actual service hostname. Fill for local verification.
DJANGO_ALLOWED_HOSTS=
DJANGO_TRUSTED_ORIGINS=
STOCKPILOT_PUBLIC_URL=
