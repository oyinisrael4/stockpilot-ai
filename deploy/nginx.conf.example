# Template for nginx on the same host as the WSGI server.
# Replace host, certificate paths and frontend dist path before enabling.
# These limit zones belong in the http {} context.
log_format stockpilot '$remote_addr $request_method $uri $status $request_time';
limit_req_zone $binary_remote_addr zone=accounts:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=connections:10m;

server { listen 80 default_server; server_name _; return 444; }
server { listen 443 ssl default_server; ssl_reject_handshake on; }
# The default TLS rejection above needs a modern nginx. Validate with nginx -t.

server {
    listen 80;
    server_name demo.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name demo.example.invalid;
    ssl_certificate /etc/ssl/stockpilot/fullchain.pem;
    ssl_certificate_key /etc/ssl/stockpilot/privkey.pem;
    root /srv/stockpilot/frontend/dist;
    access_log /var/log/nginx/stockpilot-access.log stockpilot;
    gzip on;
    gzip_types text/css application/javascript application/json;
    client_max_body_size 2m;
    client_body_timeout 15s;
    limit_conn connections 12;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location ~ ^/api/v1/auth/(login|register|reset) {
        limit_req zone=accounts burst=6 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";
        proxy_read_timeout 150s;
    }
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";
        proxy_read_timeout 150s;
    }
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }
    location / { try_files $uri $uri/ /index.html; }
    # Never proxy port 11434 or PostgreSQL. Reject unknown hosts in a separate default_server.
}
